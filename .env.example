# Copy to .env and fill in. Never commit the real file.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: gates the Streamlit app behind a password so the deployed
# ANTHROPIC_API_KEY can't be run up by strangers with the link. Leave unset
# to run the app with no gate (fine for local dev).
APP_PASSWORD=choose-something-not-guessable

# Only needed if you later add the Tavily fallback per README_architecture.md
# Section 2 ("if unavailable, fall back to Tavily or Serper API").
# TAVILY_API_KEY=tvly-...
